{
    "description": "GATES — GURPS Fourth Edition interdimensional setting wiki",
    "plugins": [
        "tiddlywiki/markdown"
    ],
    "themes": [
        "tiddlywiki/vanilla",
        "tiddlywiki/snowwhite"
    ],
    "build": {
        "player": [
            "--output",
            "static/player",
            "--deletetiddlers",
            "[!prefix[$:/]!field:gates-audience[player]]",
            "--render",
            "$:/core/save/all",
            "index.html",
            "text/plain"
        ],
        "gm": [
            "--output",
            "static/gm",
            "--deletetiddlers",
            "[!prefix[$:/]!field:gates-audience[player]!field:gates-audience[gm]]",
            "--render",
            "$:/core/save/all",
            "index.html",
            "text/plain"
        ]
    }
}
